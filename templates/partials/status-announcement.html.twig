{#
  A single announcement (active/watching or resolved). `announcement` is a
  real StatusAnnouncementObject -- `getCategoryTitles()` already drops any
  dangling category reference silently, so this template never needs to
  guard against a deleted category itself.

  Body rendering: Grav's own core `|markdown` Twig filter (`is_safe: html`,
  not sanitizing) turns the authored Markdown into HTML, then this plugin's
  `status_sanitize_html` filter (also `is_safe: html`) runs it through
  rhukster/dom-sanitizer before it reaches the page, so a `<script>` tag in
  a body never executes.
#}
<article class="status-announcement status-announcement--{{ announcement.state }} status-announcement--{{ announcement.severity }}">
    <div class="status-announcement__header">
        <h3 class="status-announcement__title">{{ announcement.title }}</h3>
        <span class="status-announcement__state status-announcement__state--{{ announcement.state }}">
            {{ announcement.state|capitalize }}
        </span>
    </div>

    {% if announcement.categoryTitles is not empty or announcement.severity != 'none' %}
        <div class="status-announcement__meta">
            {% if announcement.categoryTitles is not empty %}
                <ul class="status-announcement__categories" aria-label="Affected categories">
                    {% for title in announcement.categoryTitles %}
                        <li class="status-announcement__category-badge">{{ title }}</li>
                    {% endfor %}
                </ul>
            {% endif %}
            {% if announcement.severity != 'none' %}
                <span class="status-announcement__severity-badge status-announcement__severity-badge--{{ announcement.severity }}">
                    {{ announcement.severity|replace({'-': ' '})|capitalize }}
                </span>
            {% endif %}
        </div>
    {% endif %}

    <p class="status-announcement__dates">
        {% if announcement.ended_at %}
            {% include 'partials/status-time.html.twig' with { moment: announcement.started_at } %} to {% include 'partials/status-time.html.twig' with { moment: announcement.ended_at } %}
        {% else %}
            Started {% include 'partials/status-time.html.twig' with { moment: announcement.started_at } %}
        {% endif %}
    </p>

    {% if announcement.body %}
        <div class="status-announcement__body">
            {{ announcement.body|markdown|status_sanitize_html }}
        </div>
    {% endif %}
</article>
